      "destination": "/en/#services",
      "permanent": true
    },
    {
      "source": "/sell",
      "destination": "/en/#services",
      "permanent": true
    },
    {
      "source": "/sell/",
      "destination": "/en/#services",
      "permanent": true
    },
    {
      "source": "/home-search",
      "destination": "/en/#homes",
      "permanent": true
    },
    {
      "source": "/home-search/",
      "destination": "/en/#homes",
      "permanent": true
    },
    {
      "source": "/listings",
      "destination": "/en/#sold",
      "permanent": true
    },
    {
      "source": "/listings/",
      "destination": "/en/#sold",
      "permanent": true
    },
    {
      "source": "/success-stories",
      "destination": "/en/#sold",
      "permanent": true
    },
    {
      "source": "/success-stories/",
      "destination": "/en/#sold",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/en/#market-tools",
      "permanent": true
    },
    {
      "source": "/resources/",
      "destination": "/en/#market-tools",
      "permanent": true
    },
    {
      "source": "/home-valuation",
      "destination": "/en/#market-tools",
      "permanent": true
    },
    {
      "source": "/home-valuation/",
      "destination": "/en/#market-tools",
      "permanent": true
    },
    {
      "source": "/communities/palo-alto",
      "destination": "/cities/palo-alto.html",
      "permanent": true
